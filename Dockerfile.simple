ARG SUBCONVERTER_IMAGE=ghcr.io/aethersailor/subconverter-extended:v1.8.6@sha256:5986d0db938d85482185e51b55be3a0326e56c1ba3e3f8326895e89f31804475

FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM ${SUBCONVERTER_IMAGE} AS runtime

LABEL org.opencontainers.image.title="Subweb" \
  org.opencontainers.image.description="A compact self-hosted subscription conversion and short-link service" \
  org.opencontainers.image.source="https://github.com/keleyaa/subweb" \
  org.opencontainers.image.licenses="GPL-3.0-only"

USER root
RUN unset LD_LIBRARY_PATH \
  && apk add --no-cache nginx gettext tzdata ca-certificates \
  && rm -f /etc/nginx/http.d/default.conf

ENV TZ=Asia/Shanghai

COPY --chown=101:101 nginx/simple.conf.template /etc/nginx/simple/simple.conf.template
COPY --chown=101:101 --from=build /app/dist /usr/share/nginx/html
COPY --chown=101:101 --from=build /app/public/conf/config.js /app/public/conf/config.js
COPY --chown=101:101 --chmod=755 scripts/render-simple-gateway-config.sh /app/render-simple-gateway-config.sh
COPY --chown=101:101 --chmod=755 scripts/simple-start.sh /app/simple-start.sh
COPY --chown=101:101 --chmod=755 scripts/subconverter-docker-entrypoint.sh /usr/local/bin/subweb-subconverter-entrypoint
COPY --chown=101:101 --chmod=755 scripts/subconverter-log-supervisor.sh /usr/local/bin/subweb-log-supervisor
COPY --chown=101:101 --chmod=755 scripts/subconverter-log-filter.awk /usr/local/bin/subweb-log-filter.awk

USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD export LD_LIBRARY_PATH=; wget -q -O /dev/null --header="Host: $APP_DOMAIN" http://127.0.0.1:8080/healthz && wget -q -O /dev/null http://127.0.0.1:25500/healthz

CMD ["/app/simple-start.sh"]
