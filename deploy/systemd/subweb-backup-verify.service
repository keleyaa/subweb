[Unit]
Description=Verify the latest Subweb Redis backup in isolation
Requires=docker.service
After=docker.service subweb-backup.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/subweb
EnvironmentFile=-/etc/subweb/backup.env
ExecStart=/bin/sh -eu -c 'latest=$(find "${BACKUP_DIRECTORY:-/var/lib/subweb-backups}" -maxdepth 1 -type f \( -name "subweb-redis-*.rdb" -o -name "subweb-redis-*.rdb.age" \) -printf "%T@ %p\\n" | sort -nr | sed -n "1s/^[^ ]* //p"); [ -n "$latest" ] || { echo "No Redis backup available for verification." >&2; exit 1; }; /opt/subweb/scripts/vps/verify-backup.sh "$latest"'
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/subweb/.runtime /var/lib/subweb-backups /mnt/subweb-backups
