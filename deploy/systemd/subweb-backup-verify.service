[Unit]
Description=Verify the latest Subweb Redis backup in isolation
Requires=docker.service
RequiresMountsFor=/var/lib/subweb-backups /mnt/subweb-backups
After=docker.service remote-fs.target subweb-backup.service
Wants=remote-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/subweb
EnvironmentFile=-/etc/subweb/backup.env
ExecCondition=/bin/sh -eu -c '. /opt/subweb/scripts/vps/backup-path.sh; mount=${BACKUP_REMOTE_MOUNT:-}; [ -z "$mount" ] || { backup_path_is_supported "$mount" && command -v findmnt >/dev/null 2>&1 && backup_mount_is_distinct "$mount"; }'
ExecStart=/bin/sh -eu -c 'BACKUP_DIRECTORY=${BACKUP_DIRECTORY:-/var/lib/subweb-backups}; BACKUP_REMOTE_MOUNT=${BACKUP_REMOTE_MOUNT:-}; fail() { echo "VPS backup verification failed: $1" >&2; exit 1; }; . /opt/subweb/scripts/vps/backup-path.sh; require_supported_backup_path BACKUP_DIRECTORY "$BACKUP_DIRECTORY"; [ -z "$BACKUP_REMOTE_MOUNT" ] || require_supported_backup_path BACKUP_REMOTE_MOUNT "$BACKUP_REMOTE_MOUNT"; latest=$(find "$BACKUP_DIRECTORY" -maxdepth 1 -type f \( -name "subweb-redis-*.rdb" -o -name "subweb-redis-*.rdb.age" \) -printf "%T@ %p\\n" | sort -nr | sed -n "1s/^[^ ]* //p"); [ -n "$latest" ] || { echo "No Redis backup available for verification." >&2; exit 1; }; /opt/subweb/scripts/vps/verify-backup.sh "$latest"'
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/subweb/.runtime /var/lib/subweb-backups /mnt/subweb-backups
