[Unit]
Description=Subweb encrypted Redis backup
Requires=docker.service
After=docker.service subweb.service
Wants=subweb.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/subweb
EnvironmentFile=-/etc/subweb/backup.env
ExecStart=/opt/subweb/scripts/vps/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/subweb/.runtime /var/lib/subweb-backups /mnt/subweb-backups
