# Copy to /etc/subweb/backup.env and chmod 0600.
BACKUP_DIRECTORY=/var/lib/subweb-backups
BACKUP_RETENTION=14
MIN_FREE_KIB=10485760
# Set one or both. AGE_RECIPIENT encrypts before retention; the mount option
# requires BACKUP_DIRECTORY to be under a mounted off-host filesystem. Both
# BACKUP_DIRECTORY and BACKUP_REMOTE_MOUNT must be under /var/lib/subweb-backups
# or /mnt/subweb-backups, the paths allowed by the systemd backup units.
AGE_RECIPIENT=age1example
# BACKUP_REMOTE_MOUNT=/mnt/subweb-backups
# AGE_IDENTITY_FILE=/etc/subweb/backup-identity.txt
