# Generate a private .env with ./scripts/configure.sh. Do not copy secret placeholders
# below into a live deployment. The generated file is mode 0600.
APP_DOMAIN=sub.ml1.one
API_DOMAIN=api.ml1.one
SHORT_DOMAIN=ml1.one
API_URL=https://api.ml1.one
SUBWEB_PORT=18080

# The default production stack runs four services. Set SHORT_LINKS_ENABLED=false
# to use compose.disabled-short-links.yaml, which runs only Gateway and SubConverter
# and does not require SHORT_DOMAIN, Redis, MyUrls, or Turnstile secrets.
SHORT_LINKS_ENABLED=true
CUSTOM_BACKEND_ENABLED=true

# Gateway log level. info records one access line per request (health and
# readiness probes are excluded) and keeps the level that operators expect;
# use warn or error to keep only failures, or debug for temporary diagnostics.
LOG_LEVEL=info

# Optional MyUrls log verbosity. Its info level writes one line per health probe
# and cannot be filtered by route, so production keeps warn: short-link activity
# is already recorded by the Gateway access log.
# MYURLS_LOG_LEVEL=warn

# Optional: trust exactly this reverse-proxy source before using its client-IP header.
# TRUSTED_PROXY_CIDR=172.18.0.1/32

# Optional immutable prebuilt Gateway image selected by scripts/subweb.sh install.
# SUBWEB_IMAGE=docker.io/keleyaa/subweb@sha256:<64-hex-digest>

# configure.sh generates REDIS_IMAGE, SUBCONVERTER_IMAGE, and MYURLS_IMAGE
# from deploy/versions.lock.json. Do not set those managed runtime values manually.

# Short-link mode only. configure.sh generates independent 64-character hex values
# and keeps them stable unless --rotate-secrets is provided.
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
IP_HASH_SECRET=REPLACE_WITH_64_CHARACTER_HEX
REDIS_PASSWORD=REPLACE_WITH_64_CHARACTER_HEX

# Gateway conversion policy defaults.
CONVERSION_RATE_LIMIT=10
CONVERSION_RATE_WINDOW_SECONDS=60
CONVERSION_MAX_REQUEST_BYTES=16384
CONVERSION_MAX_RESPONSE_BYTES=8388608
CONVERSION_REQUEST_TIMEOUT_MS=10000
CONVERSION_DNS_TIMEOUT_MS=2000
CONVERSION_EGRESS_CONNECT_TIMEOUT_MS=5000
CONVERSION_MAX_CONCURRENCY=4
# One client may hold at most this many conversion slots, so a single caller
# cannot occupy every shared slot while other clients are rejected.
CONVERSION_MAX_CONCURRENCY_PER_IP=2

# Advanced: hostnames MyUrls may reach through the Gateway's restricted CONNECT
# listener. Keep challenges.cloudflare.com so Turnstile verification works;
# MyUrls has no direct public network.
# EGRESS_ALLOWED_HOSTS=challenges.cloudflare.com
