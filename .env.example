# Generate a private .env with ./scripts/configure.sh. Do not copy the secret
# placeholders below into a live deployment.
APP_DOMAIN=sub.ml1.one
API_DOMAIN=api.ml1.one
SHORT_DOMAIN=ml1.one
API_URL=https://api.ml1.one

# Hardened Compose only: trust exactly this reverse-proxy source before using
# its X-Forwarded-For value for Request Policy rate limits and upstream headers.
# The default three-service deployment intentionally does not consume this value.
# TRUSTED_PROXY_CIDR=172.18.0.1/32

# Optional prebuilt Gateway image selected by scripts/docker-deploy.sh.
# SUBWEB_IMAGE=docker.io/keleyaa/subweb:sha-2bf1a9f

# Optional MyUrls image override. Leave unset to use Compose's verified Rust
# v2.0.6 manifest digest. Use only a Rust MyUrls image compatible with /api/links;
# a Node v1 /api/v1/links image requires a matching Subweb rollback.
# MYURLS_IMAGE=

# MyUrls is not published. The default proxy replaces X-Forwarded-For before
# forwarding. Docker's usual 172.16.0.0/12 private allocation is trusted.
# MYURLS_TRUST_PROXY_CIDR=172.16.0.0/12

# Local gateway port; the bind address is always loopback. Put TLS and host
# routing in the external reverse proxy.
SUBWEB_PORT=18080

# Provide Cloudflare Turnstile credentials to configure.sh. The default MyUrls
# instance validates challenges for APP_DOMAIN, where short links are created.
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# configure.sh generates independent 64-character hex values and keeps them
# stable unless --rotate-secrets is provided.
IP_HASH_SECRET=REPLACE_WITH_64_CHARACTER_HEX
REDIS_PASSWORD=REPLACE_WITH_64_CHARACTER_HEX

# Hardened Compose only: anonymous conversion policy defaults. Increase only
# after reviewing upstream capacity and rerunning the security/integration checks.
CONVERSION_RATE_LIMIT=10
CONVERSION_RATE_WINDOW_SECONDS=60
CONVERSION_MAX_REQUEST_BYTES=16384
CONVERSION_MAX_RESPONSE_BYTES=8388608
CONVERSION_REQUEST_TIMEOUT_MS=10000
CONVERSION_DNS_TIMEOUT_MS=2000
CONVERSION_EGRESS_CONNECT_TIMEOUT_MS=5000
CONVERSION_MAX_CONCURRENCY=2

# Optional Compose-first local development ports.
LOCAL_VITE_PORT=5173
LOCAL_SUBWEB_PORT=18081
LOCAL_MYURLS_PORT=18082
