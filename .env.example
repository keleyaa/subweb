# Generate a private .env with ./scripts/configure.sh. Do not copy the secret
# placeholders below into a live deployment.
COMPOSE_PROFILES=behind-proxy
DOMAIN_MODE=three-domain
APP_DOMAIN=ml1.one
API_DOMAIN=api.ml1.one
SHORT_DOMAIN=s.ml1.one
API_URL=https://api.ml1.one
SHORT_URL=https://s.ml1.one/short-api

# Optional prebuilt Gateway image selected by scripts/docker-deploy.sh.
# SUBWEB_IMAGE=docker.io/keleyaa/subweb:sha-2bf1a9f

# Optional MyUrls image override. Omit this line to follow the latest stable
# MyUrls release; use an immutable tag or digest only when a controlled rollback
# is required.
# MYURLS_IMAGE=ghcr.io/keleyaa/myurls:latest

# Local port for the behind-proxy profile; the bind address is always loopback.
SUBWEB_PORT=18080

# Used only by the direct-tls profile. Paths must be absolute.
TLS_CERT_PATH=/absolute/path/to/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/privkey.pem

# configure.sh replaces these placeholders with independent 64-character hex
# values and keeps them stable unless --rotate-secrets is provided.
MYURLS_API_TOKEN=REPLACE_WITH_64_CHARACTER_HEX
REDIS_PASSWORD=REPLACE_WITH_64_CHARACTER_HEX

# Optional local-source runtime overrides. Existing checkout paths must be
# absolute and already point at the commits locked in deploy/versions.lock.json.
LOCAL_VITE_PORT=5173
LOCAL_SUBCONVERTER_PORT=25500
LOCAL_MYURLS_PORT=18082
LOCAL_REDIS_PORT=16379
LOCAL_APP_PORT=18080
LOCAL_API_PORT=18081
LOCAL_SHORT_PORT=18083
# MYURLS_SOURCE_DIR=/absolute/path/to/MyUrls
# SUBCONVERTER_SOURCE_DIR=/absolute/path/to/SubConverter-Extended
# BUILD_JOBS=4
