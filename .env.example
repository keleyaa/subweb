# Generate a private .env with ./scripts/configure.sh. Do not copy the secret
# placeholders below into a live deployment.
APP_DOMAIN=ml1.one
API_DOMAIN=api.ml1.one
SHORT_DOMAIN=s.ml1.one
API_URL=https://api.ml1.one

# Optional: trust exactly this reverse-proxy source before using its
# X-Forwarded-For value for Gateway rate limits and upstream client IP headers.
# TRUSTED_PROXY_CIDR=172.18.0.1/32

# Optional prebuilt Gateway image selected by scripts/docker-deploy.sh.
# SUBWEB_IMAGE=docker.io/keleyaa/subweb:sha-2bf1a9f

# Optional MyUrls rollback override. The Compose default is the verified v2.0.0
# manifest digest and must remain immutable in production.
# MYURLS_IMAGE=ghcr.io/keleyaa/myurls:v1.13.0@sha256:b98836c038e070c8f889f391d63bd9535aee93ce91753f4bb30353f3395d0915

# Optional dedicated Gateway-to-MyUrls network overrides. The trusted CIDR must
# identify only the Gateway address on this network.
# MYURLS_NETWORK_SUBNET=172.30.255.0/29
# MYURLS_GATEWAY_IP=172.30.255.2
# MYURLS_APP_IP=172.30.255.3
# MYURLS_SHORT_IP=172.30.255.4
# MYURLS_TRUST_PROXY_CIDR=172.30.255.2/32

# Local gateway port; the bind address is always loopback. Put TLS and host
# routing in the external reverse proxy.
SUBWEB_PORT=18080

# Provide Cloudflare Turnstile credentials to configure.sh. Compose derives
# the expected hostname separately from APP_DOMAIN and SHORT_DOMAIN.
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# configure.sh generates independent 64-character hex values and keeps them
# stable unless --rotate-secrets is provided.
IP_HASH_SECRET=REPLACE_WITH_64_CHARACTER_HEX
REDIS_PASSWORD=REPLACE_WITH_64_CHARACTER_HEX

# Anonymous conversion policy defaults. Increase only after reviewing upstream
# capacity and rerunning the security/integration checks.
CONVERSION_RATE_LIMIT=10
CONVERSION_RATE_WINDOW_SECONDS=60
CONVERSION_MAX_REQUEST_BYTES=16384
CONVERSION_MAX_RESPONSE_BYTES=8388608
CONVERSION_REQUEST_TIMEOUT_MS=10000
CONVERSION_DNS_TIMEOUT_MS=2000
CONVERSION_MAX_CONCURRENCY=2

# Optional Compose-first local development ports.
LOCAL_VITE_PORT=5173
LOCAL_SUBCONVERTER_PORT=25500
LOCAL_MYURLS_PORT=18082
LOCAL_SHORT_MYURLS_PORT=18083
