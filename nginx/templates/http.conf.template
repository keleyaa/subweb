worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr crit;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;

 @@CONTENT_TYPE_MAP@@

  client_body_temp_path /tmp/nginx/client_temp;
  proxy_temp_path /tmp/nginx/proxy_temp;
  fastcgi_temp_path /tmp/nginx/fastcgi_temp;
  uwsgi_temp_path /tmp/nginx/uwsgi_temp;
  scgi_temp_path /tmp/nginx/scgi_temp;

  map $uri $privacy_route {
    default $uri;
    "~^/[A-Za-z0-9_-]{1,64}$" "/:shortKey";
  }

  log_format gateway_privacy '$time_iso8601 $request_method $privacy_route $status';
  access_log /dev/stdout gateway_privacy;
  limit_req_zone $binary_remote_addr zone=subweb_api:10m rate=60r/m;
  limit_req_zone $binary_remote_addr zone=subweb_short:10m rate=20r/m;
  limit_req_status 429;

  map $http_origin $short_origin_allowed {
    default 0;
    "@@PUBLIC_SCHEME@@://@@APP_DOMAIN@@" 1;
  }

  map $http_origin $short_allowed_origin {
    default "";
    "@@PUBLIC_SCHEME@@://@@APP_DOMAIN@@" "@@PUBLIC_SCHEME@@://@@APP_DOMAIN@@";
  }

  map $http_origin $short_allowed_origin_unused {
    default "";
  }

  map $http_origin $myurls_ui_origin_allowed {
    default 0;
    "@@PUBLIC_SCHEME@@://@@SHORT_DOMAIN@@" 1;
  }

  map $http_origin $myurls_ui_allowed_origin {
    default "";
    "@@PUBLIC_SCHEME@@://@@SHORT_DOMAIN@@" "@@PUBLIC_SCHEME@@://@@SHORT_DOMAIN@@";
  }

  resolver @@NGINX_RESOLVER@@ ipv6=off valid=30s;

  server {
    listen @@HTTP_LISTEN@@ default_server;
    server_name _;
    return 421;
  }

  server {
    listen @@HTTP_LISTEN@@;
    server_name @@APP_DOMAIN@@;
    root /usr/share/nginx/html;
    index index.html;

@@SECURITY_HEADERS@@
 @@APP_ROUTES@@
  }

  server {
    listen @@HTTP_LISTEN@@;
    server_name @@API_DOMAIN@@;

 @@SECURITY_HEADERS@@
 @@API_ROUTES@@
  }

@@SHORT_SERVER@@
}
