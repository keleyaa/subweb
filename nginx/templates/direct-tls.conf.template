worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr crit;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;

 @@CONTENT_TYPE_MAP@@

  client_body_temp_path /tmp/nginx/client_temp;
  proxy_temp_path /tmp/nginx/proxy_temp;
  fastcgi_temp_path /tmp/nginx/fastcgi_temp;
  uwsgi_temp_path /tmp/nginx/uwsgi_temp;
  scgi_temp_path /tmp/nginx/scgi_temp;

  map $uri $privacy_route {
    default $uri;
    "~^/[A-Za-z0-9_-]{1,64}$" "/:shortKey";
  }

  log_format gateway_privacy '$time_iso8601 $request_method $privacy_route $status';
  access_log /dev/stdout gateway_privacy;
  limit_req_zone $binary_remote_addr zone=subweb_api:10m rate=60r/m;
  limit_req_zone $binary_remote_addr zone=subweb_short:10m rate=20r/m;
  limit_req_status 429;

  resolver @@NGINX_RESOLVER@@ ipv6=off valid=30s;

  server {
    listen 8080 default_server;
    server_name _;
    return 421;
  }

  server {
    listen 8080;
    server_name @@APP_DOMAIN@@ @@API_DOMAIN@@;
    return 308 https://$host$request_uri;
  }

  server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate @@TLS_CERT_PATH@@;
    ssl_certificate_key @@TLS_KEY_PATH@@;
    return 421;
  }

  server {
    listen 8443 ssl;
    server_name @@APP_DOMAIN@@;
    ssl_certificate @@TLS_CERT_PATH@@;
    ssl_certificate_key @@TLS_KEY_PATH@@;
    root /usr/share/nginx/html;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000" always;
 @@SECURITY_HEADERS@@
 @@APP_ROUTES@@
  }

  server {
    listen 8443 ssl;
    server_name @@API_DOMAIN@@;
    ssl_certificate @@TLS_CERT_PATH@@;
    ssl_certificate_key @@TLS_KEY_PATH@@;

    add_header Strict-Transport-Security "max-age=31536000" always;
 @@SECURITY_HEADERS@@
 @@API_ROUTES@@
  }
}
