location = /healthz {
  access_log off;
  default_type text/plain;
  if ($request_method != GET) { return 405; }
  return 200 "ok\n";
}

location = /sub {
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  limit_req zone=subweb_api burst=10 nodelay;
  limit_except GET {
    deny all;
  }
  client_max_body_size 16k;
  proxy_set_header Authorization "";
  proxy_set_header Proxy-Authorization "";
  proxy_set_header Cookie "";
  proxy_set_header Origin "";
@@API_PROXY_HEADERS@@
  set $subconverter_upstream "@@SUBCONVERTER_UPSTREAM@@";
  proxy_pass $subconverter_upstream$request_uri;
@@SECURITY_HEADERS@@
}

location / {
  return 421;
}
