location = /healthz {
  access_log off;
  default_type text/plain;
  if ($request_method != GET) { return 405; }
  return 200 "ok\n";
}

location = /runtime-index.html {
  internal;
  default_type text/html;
  alias @@RUNTIME_SITE_ROOT@@/index.html;
}

location = /index.html {
  rewrite ^ /runtime-index.html last;
}

location = /favicon.svg {
  try_files $uri =404;
}

location = /apple-touch-icon.png {
  try_files $uri =404;
}

location = /icon-192.png {
  try_files $uri =404;
}

location = /icon-512.png {
  try_files $uri =404;
}

location = /site.webmanifest {
  default_type application/manifest+json;
  try_files $uri =404;
}

location = /robots.txt {
  default_type text/plain;
  alias @@RUNTIME_SITE_ROOT@@/robots.txt;
}

location = /sitemap.xml {
  default_type application/xml;
  alias @@RUNTIME_SITE_ROOT@@/sitemap.xml;
}

location ^~ /assets/ {
  expires 1y;
  try_files $uri =404;
}

location ^~ /conf/ {
  expires -1;
  try_files $uri =404;
}

location = /short-api/links {
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  limit_req zone=subweb_short burst=5 nodelay;
  if ($short_origin_allowed = 0) {
    return 403;
  }
  limit_except POST {
    deny all;
  }
  if ($myurls_json_content_type_allowed = 0) {
    return 415;
  }
  if ($args != "") {
    return 404;
  }
  client_max_body_size @@MYURLS_MAX_BODY_BYTES@@;
  proxy_set_header Authorization "";
  proxy_set_header Proxy-Authorization "";
  proxy_set_header Cookie "";
  proxy_set_header Origin "";
  proxy_set_header X-Request-ID $request_id;
@@MYURLS_PROXY_HEADERS@@
  set $myurls_upstream "@@MYURLS_APP_UPSTREAM@@";
  proxy_pass $myurls_upstream/api/links;
@@SECURITY_HEADERS@@
}

location ^~ /short-api/ {
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  return 404;
@@SECURITY_HEADERS@@
}

location ~ "^/[A-Za-z0-9_-]{1,64}$" {
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  limit_except GET HEAD {
    deny all;
  }
@@APP_PROXY_HEADERS@@
  proxy_set_header Authorization "";
  set $myurls_upstream "@@MYURLS_APP_UPSTREAM@@";
  proxy_pass $myurls_upstream$request_uri;
@@SECURITY_HEADERS@@
}

location = / {
  rewrite ^ /runtime-index.html last;
}

location / {
  try_files $uri $uri/ /runtime-index.html;
}
