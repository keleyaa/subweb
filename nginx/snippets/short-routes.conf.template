location = /short {
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header Access-Control-Allow-Origin $myurls_ui_allowed_origin always;
  add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
  add_header Access-Control-Allow-Headers "Content-Type" always;
  add_header Vary Origin always;
  limit_req zone=subweb_short burst=5 nodelay;
  if ($myurls_ui_origin_allowed = 0) {
    return 403;
  }
  if ($request_method = OPTIONS) {
    return 204;
  }
  if ($request_method != POST) {
    return 405;
  }
  if ($myurls_ui_content_type_allowed = 0) {
    return 415;
  }
  client_max_body_size @@MYURLS_MAX_BODY_BYTES@@;
  proxy_set_header Authorization "";
  proxy_set_header Proxy-Authorization "";
  proxy_set_header Authorization "Bearer @@MYURLS_API_TOKEN@@";
@@SHORT_PROXY_HEADERS@@
  set $myurls_upstream "@@MYURLS_UPSTREAM@@";
  proxy_pass $myurls_upstream/short$is_args$args;
@@SECURITY_HEADERS@@
}

location ~ "^/[A-Za-z0-9_-]{1,64}$" {
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  limit_except GET HEAD {
    deny all;
