worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr crit;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  client_body_temp_path /tmp/nginx/client_temp;
  proxy_temp_path /tmp/nginx/proxy_temp;
  fastcgi_temp_path /tmp/nginx/fastcgi_temp;
  uwsgi_temp_path /tmp/nginx/uwsgi_temp;
  scgi_temp_path /tmp/nginx/scgi_temp;

  map $uri $privacy_route {
    default $uri;
    "~^/[A-Za-z0-9_-]{1,64}$" "/:shortKey";
  }

  map $http_origin $short_origin_allowed {
    default 0;
    "https://@@APP_DOMAIN@@" 1;
  }

  map $http_content_type $myurls_json_content_type_allowed {
    default 0;
    "~*^application/json([ \\t]*;[ \\t]*[A-Za-z0-9_-]+[ \\t]*=[ \\t]*(\"[A-Za-z0-9._ -]+\"|[A-Za-z0-9._-]+))*[ \\t]*$" 1;
  }

  log_format gateway_privacy '$time_iso8601 $request_method $privacy_route $status';
  access_log /dev/stdout gateway_privacy;
  limit_req_zone $binary_remote_addr zone=subweb_api:10m rate=60r/m;
  limit_req_zone $binary_remote_addr zone=subweb_short:10m rate=20r/m;
  limit_req_status 429;
  resolver @@NGINX_RESOLVER@@ ipv6=off valid=30s;

  server {
    listen 8080 default_server;
    server_name _;
    return 421;
  }

  server {
    listen 8080;
    server_name @@APP_DOMAIN@@;
    root /usr/share/nginx/html;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com; img-src 'self' data:; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location = /healthz {
      access_log off;
      default_type text/plain;
      if ($request_method != GET) { return 405; }
      return 200 "ok\\n";
    }

    location = /runtime-index.html {
      internal;
      default_type text/html;
      alias @@RUNTIME_SITE_ROOT@@/index.html;
    }

    location = /index.html {
      rewrite ^ /runtime-index.html last;
    }

    location = /favicon.svg { try_files $uri =404; }
    location = /apple-touch-icon.png { try_files $uri =404; }
    location = /icon-192.png { try_files $uri =404; }
    location = /icon-512.png { try_files $uri =404; }
    location = /site.webmanifest {
      default_type application/manifest+json;
      try_files $uri =404;
    }
    location = /robots.txt {
      default_type text/plain;
      alias @@RUNTIME_SITE_ROOT@@/robots.txt;
    }
    location = /sitemap.xml {
      default_type application/xml;
      alias @@RUNTIME_SITE_ROOT@@/sitemap.xml;
    }
    location ^~ /assets/ {
      expires 1y;
      try_files $uri =404;
    }
    location ^~ /conf/ {
      expires -1;
      try_files $uri =404;
    }

    location = /short-api/links {
      add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
      limit_req zone=subweb_short burst=5 nodelay;
      if ($short_origin_allowed = 0) { return 403; }
      limit_except POST { deny all; }
      if ($myurls_json_content_type_allowed = 0) { return 415; }
      if ($args != "") { return 404; }
      client_max_body_size @@MYURLS_MAX_BODY_BYTES@@;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host @@APP_DOMAIN@@;
      proxy_set_header X-Forwarded-Host @@APP_DOMAIN@@;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Forwarded "";
      proxy_set_header Authorization "";
      proxy_set_header Proxy-Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header Origin "";
      proxy_set_header X-Request-ID $request_id;
      set $myurls_upstream "@@MYURLS_UPSTREAM@@";
      proxy_pass $myurls_upstream/api/links;
    }

    location ^~ /short-api/ {
      add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
      return 404;
    }

    location ~ "^/[A-Za-z0-9_-]{1,64}$" {
      add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
      limit_except GET HEAD { deny all; }
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host @@APP_DOMAIN@@;
      proxy_set_header X-Forwarded-Host @@APP_DOMAIN@@;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Forwarded "";
      proxy_set_header Authorization "";
      proxy_set_header Proxy-Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header Origin "";
      proxy_set_header X-Request-ID $request_id;
      set $myurls_upstream "@@MYURLS_UPSTREAM@@";
      proxy_pass $myurls_upstream$request_uri;
    }

    location = / { rewrite ^ /runtime-index.html last; }
    location / { try_files $uri $uri/ /runtime-index.html; }
  }

  server {
    listen 8080;
    server_name @@API_DOMAIN@@;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /healthz {
      access_log off;
      default_type text/plain;
      if ($request_method != GET) { return 405; }
      return 200 "ok\\n";
    }

    location = /sub {
      add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
      limit_req zone=subweb_api burst=10 nodelay;
      limit_except GET { deny all; }
      client_max_body_size 16k;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host @@API_DOMAIN@@;
      proxy_set_header X-Forwarded-Host @@API_DOMAIN@@;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Forwarded "";
      proxy_set_header Authorization "";
      proxy_set_header Proxy-Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header Origin "";
      proxy_set_header X-Request-ID $request_id;
      set $subconverter_upstream "@@SUBCONVERTER_UPSTREAM@@";
      proxy_pass $subconverter_upstream$request_uri;
    }

    location / { return 421; }
  }

  server {
    listen 8080;
    server_name @@SHORT_DOMAIN@@;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /healthz {
      access_log off;
      default_type text/plain;
      if ($request_method != GET) { return 405; }
      return 200 "ok\\n";
    }

    location = /api/links { return 404; }
    location ^~ /api/ { return 404; }
    location ~ "^/[A-Za-z0-9_-]{1,64}$" {
      add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
      limit_except GET HEAD { deny all; }
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host @@SHORT_DOMAIN@@;
      proxy_set_header X-Forwarded-Host @@SHORT_DOMAIN@@;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Forwarded "";
      proxy_set_header Authorization "";
      proxy_set_header Proxy-Authorization "";
      proxy_set_header Cookie "";
      proxy_set_header Origin "";
      proxy_set_header X-Request-ID $request_id;
      set $myurls_upstream "@@MYURLS_UPSTREAM@@";
      proxy_pass $myurls_upstream$request_uri;
    }

    location / { return 404; }
  }
}
